# App environment: development | production
NEXT_PUBLIC_ENVIRONMENT=development

# Reown / WalletConnect project ID
# https://dashboard.reown.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id

# Optional canonical site origin for sitemap and absolute URLs (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://deshop.space

# Legacy chat WebSocket auth via ?token= query (insecure: leaks into access logs / Referer).
# Default is Sec-WebSocket-Protocol + first-message auth. Set true only in development if
# the API gateway has not been updated yet. Ignored in production builds.
# NEXT_PUBLIC_WS_AUTH_IN_QUERY=true
